# Choose "ollama" for a local Llama model or "gemini" for Google Gemini.
LLM_PROVIDER=ollama

# Local Ollama (recommended development default)
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# Gemini (set LLM_PROVIDER=gemini and add your key; never commit .env)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
